# Public URL used for OAuth callbacks. In Dockploy set your HTTPS URL.
APP_URL=http://localhost:3000
APP_SECRET=change-this-to-at-least-32-random-characters
ENCRYPTION_KEY=change-this-to-a-fernet-key
APP_ENV=development
REGISTRATION_MODE=invite

# Comma-separated, case-insensitive allowlist. Nobody else can sign in.
ALLOWED_EMAILS=you@example.com

# Google login and Drive connector. Create a Web OAuth client in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development preview only. Ignored when APP_ENV is not development.
DEV_LOGIN_EMAIL=demo@example.com

# Storage and sync
DATA_DIR=/data
COUCHDB_URL=http://couchdb:5984
COUCHDB_ADMIN_USER=ink2vault
COUCHDB_ADMIN_PASSWORD=change-this-couchdb-password
LIVESYNC_PUBLIC_URL=
OCR_URL=http://ocr:8000
OCR_DOMAIN=handwritten

# AI defaults. Per-user credentials are entered in the web UI and encrypted.
CLAUDE_MODEL=sonnet
GEMINI_MODEL=gemini-2.5-flash

# Queue and resource-friendly OCR defaults for a shared server.
JOB_CONCURRENCY=1
SYNC_INTERVAL_SECONDS=300
TUZKAOCR_PAGE_WORKERS=1
TUZKAOCR_LINE_WORKERS=2
TUZKAOCR_OCR_THREADS=2
TUZKAOCR_CPU_MEM_ARENA=false
LOG_LEVEL=info

# Defaults users can change in the web UI.
DEFAULT_NOTE_FOLDER=Inbox
DEFAULT_ATTACHMENT_FOLDER=Attachments/Rukopis
DEFAULT_SOURCE_LABEL=Rukopis
